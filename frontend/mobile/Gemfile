source 'https://rubygems.org'

# ==================== iOS 构建工具版本 ====================
# Ruby 是执行 CocoaPods 等 iOS 构建工具的语言，这里只规定项目支持的最低版本。
ruby ">= 2.6.10"

# 这些版本范围避开已知会导致安装或 Xcode 工程解析失败的组合，升级时需先验证 iOS 构建。
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'xcodeproj', '< 1.26.0'
gem 'concurrent-ruby', '< 1.3.4'

# Ruby 3.4 不再内置下面这些基础库，显式声明可让新旧 Ruby 都使用同一套安装流程。
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
